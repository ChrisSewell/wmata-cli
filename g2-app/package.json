{
  "name": "wmata-g2",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5273 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5273",
    "test": "vitest run",
    "test:watch": "vitest",
    "qr": "evenhub qr --http -p 5273 --path /",
    "pack": "npm run build && evenhub pack app.json dist -o wmata-transit.ehpk",
    "simulate": "evenhub-simulator http://localhost:5273",
    "sim:drive": "node scripts/sim.mjs",
    "verify:sim": "node scripts/sim.mjs ready"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.11",
    "@evenrealities/pretext": "^0.1.4"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.7.2",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
